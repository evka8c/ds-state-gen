    { "id": "email-already-registered", "keywords": ["already registered", "already exists", "email taken", "existing account"] },
    { "id": "check-your-email", "keywords": ["check your email", "verification sent", "email sent"] },
    { "id": "resend-verification", "keywords": ["resend"] },
    { "id": "link-expired", "keywords": ["link expired", "expired link", "token expired", "verification expired"] },
    { "id": "link-invalid-or-used", "keywords": ["invalid link", "already used", "already verified", "invalid token"] },
    { "id": "verified-success", "keywords": ["verified", "email confirmed", "account activated"] },
    { "id": "sign-in-unverified", "keywords": ["unverified", "not verified", "verify before"], "required": false },
